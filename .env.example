# Frontend environment variables. Copy to `.env.local` and adjust.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL for the BFF. Leave empty to use the dev-server proxy (see vite.config.ts),
# which forwards /api to http://localhost:7071 (Azure Functions Core Tools).
VITE_API_BASE_URL=

# When "true", the app falls back to local mocks if the BFF is unreachable, so the
# UI is usable with `pnpm dev` alone. Defaults to true in dev, false in production
# builds — where an unreachable BFF must queue the work for retry instead.
VITE_ALLOW_MOCK_AI=true
