{
  // https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "default": true,
  "MD013": false,        // line length — markdown is prose, let it breathe
  "MD022": false,        // blanks-around-headings
  "MD024": { "siblings_only": true },
  "MD025": false,        // multiple top-level headings (we use # for section blocks)
  "MD026": false,        // trailing punctuation in headings
  "MD031": false,        // blanks-around-fences
  "MD032": false,        // blanks-around-lists
  "MD033": false,        // inline HTML allowed (badges, details)
  "MD034": false,        // bare URLs (Code-of-Conduct attribution)
  "MD036": false,        // emphasis-as-heading — used for callouts
  "MD040": false,        // fenced-code-language — ASCII diagrams use plain fences
  "MD041": false         // first-line-h1 — README badges first is fine
}
