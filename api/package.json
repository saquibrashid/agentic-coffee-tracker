{
  "name": "@agentic-coffee-tracker/api",
  "version": "0.1.0",
  "private": true,
  "description": "BFF for Coffee Bean Tracker — Azure Functions v4, Node 20, TypeScript.",
  "license": "MIT",
  "main": "dist/src/functions/*.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "package": "node scripts/package.mjs",
    "watch": "tsc -p tsconfig.build.json -w",
    "prestart": "pnpm run build",
    "start": "func start",
    "dev": "concurrently -k -n tsc,func \"pnpm watch\" \"func start\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.0",
    "@azure/functions": "^4.16.2",
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.33.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.4",
    "rimraf": "^6.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
