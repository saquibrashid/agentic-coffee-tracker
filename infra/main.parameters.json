{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "visionEndpoint": {
      "value": "${AZURE_VISION_ENDPOINT=}"
    },
    "visionKey": {
      "value": "${AZURE_VISION_KEY=}"
    },
    "openAiEndpoint": {
      "value": "${AZURE_OPENAI_ENDPOINT=}"
    },
    "openAiKey": {
      "value": "${AZURE_OPENAI_KEY=}"
    },
    "openAiDeployment": {
      "value": "${AZURE_OPENAI_DEPLOYMENT=}"
    },
    "imageEndpoint": {
      "value": "${AZURE_IMAGE_ENDPOINT=}"
    },
    "imageKey": {
      "value": "${AZURE_IMAGE_KEY=}"
    },
    "imageDeployment": {
      "value": "${AZURE_IMAGE_DEPLOYMENT=}"
    },
    "imageModelName": {
      "value": "${AZURE_IMAGE_MODEL=}"
    },
    "staticWebAppSkuName": {
      "value": "${STATIC_WEB_APP_SKU=Free}"
    },
    "syncAccessMode": {
      "value": "${SYNC_ACCESS_MODE=owner}"
    },
    "syncAllowlist": {
      "value": "${SYNC_ALLOWLIST=}"
    },
    "syncRecordQuota": {
      "value": "${SYNC_RECORD_QUOTA=20000}"
    }
  }
}
