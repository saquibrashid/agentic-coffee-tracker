dist/
build/
out/
.vite/
*.tsbuildinfo

# --- Test / coverage ---
coverage/
.playwright/
playwright-report/
test-results/

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/

# --- Environment & secrets ---
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx

# --- Azure Functions ---
api/local.settings.json
api/deploy/
api/bin/
api/obj/
.azure/
__azurite_db_*__.json
__blobstorage__/
__queuestorage__/

# --- azd ---
.azd/

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Service worker artifacts ---
public/sw.js
public/workbox-*.js
public/registerSW.js

# --- PWA assets generated at build ---
# public/pwa-*.png is deliberately NOT ignored. It used to be, on the assumption
# that something generated the icons during the build. Nothing did, so the
# manifest shipped pointing at three files that had never existed and the app
# was never installable. They are rendered from build-config/icons/*.svg by
# scripts/generate-icons.mjs and committed; build-config/pwaIcons.test.ts fails
# if one goes missing again.
public/manifest.webmanifest

# --- Misc ---
*.local
.cache/
.eslintcache
.parcel-cache/
