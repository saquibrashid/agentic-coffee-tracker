{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist/node",
    "tsBuildInfoFile": "dist/.tsbuildinfo-node",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.sync.config.ts",
    "playwright.csp.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "build-config/**/*.ts"
  ]
}
